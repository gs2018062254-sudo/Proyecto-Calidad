# Variables de entorno frontend (prefijo VITE_ para que Vite las exponga)
# Copiar a web/.env.development.local o similar (NO commitear)

# Mismo Client ID que en el backend: GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=

# Si la API corre en otro host (default: proxy /api -> localhost:5001)
# VITE_API_BASE=
