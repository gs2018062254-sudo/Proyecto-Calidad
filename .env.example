# ==========================================================================
# Variables de entorno para SAST Studio
# Copia este archivo a .env (NO COMMITEAR .env) y rellena valores reales.
# En Vercel: Project Settings -> Environment Variables
# ==========================================================================

# --- JWT (RECOMENDADO: generar con `openssl rand -hex 32`) ---
JWT_SECRET=dev-secret-change-me-please-123456

# --- Google OAuth 2.0 (Sign-In rápido — https://console.cloud.google.com/apis/credentials)
# Crear: APIs & Services → Credentials → Create credentials → OAuth client ID → Web application
# Authorized redirect URIs (local):  http://localhost:5001/api/auth/callback
# Authorized redirect URIs (prod):   https://TU-DOMINIO.vercel.app/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Redirect Base (optional) ---
# Si usas Vercel serverless, puede ser distinto. Por defecto se detecta.
# OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/callback

# --- Flask (solo local/dev) ---
# PORT=5001
# DEBUG=true
